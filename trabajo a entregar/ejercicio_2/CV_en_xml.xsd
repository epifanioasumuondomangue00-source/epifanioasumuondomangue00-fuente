<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ========== Tipos simples ========== -->

  <!-- Texto que no puede estar vacío -->
  <xs:simpleType name="TextoNoVacio">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Teléfono: 9 dígitos, con prefijo internacional opcional (+34...) -->
  <xs:simpleType name="Telefono">
    <xs:restriction base="xs:string">
      <xs:pattern value="(\+[0-9]{1,3})?[0-9]{9}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Correo electrónico: texto@dominio.extension -->
  <xs:simpleType name="CorreoElectronico">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^@\s]+@[^@\s]+\.[^@\s]+"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ========== Tipos complejos ========== -->

  <!-- Datos personales: nombre, título, teléfono y email -->
  <xs:complexType name="DatosPersonalesType">
    <xs:sequence>
      <xs:element name="nombre" type="TextoNoVacio"/>
      <xs:element name="titulo" type="TextoNoVacio"/>
      <xs:element name="Numero_de_telefono" type="Telefono"/>
      <xs:element name="Email" type="CorreoElectronico"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PresentacionType">
    <xs:sequence>
      <xs:element name="datos_personales" type="DatosPersonalesType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Lista de puntos de la sección "sobre mí" -->
  <xs:complexType name="SobreMiType">
    <xs:sequence>
      <xs:element name="punto" type="TextoNoVacio" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Lista reutilizable de conocimientos -->
  <xs:complexType name="ListaConocimientosType">
    <xs:sequence>
      <xs:element name="conocimiento" type="TextoNoVacio" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ConocimientosType">
    <xs:sequence>
      <xs:element name="sistemas_y_redes" type="ListaConocimientosType"/>
      <xs:element name="programacion_y_desarrollo" type="ListaConocimientosType"/>
      <xs:element name="ofimatica" type="ListaConocimientosType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ActualmenteAprendiendoType">
    <xs:sequence>
      <xs:element name="tema" type="TextoNoVacio" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="AreasType">
    <xs:sequence>
      <xs:element name="area" type="TextoNoVacio" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ObjetivoDePracticaType">
    <xs:sequence>
      <xs:element name="descripcion" type="TextoNoVacio"/>
      <xs:element name="areas" type="AreasType"/>
      <xs:element name="nota_final" type="TextoNoVacio"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EstudiosType">
    <xs:sequence>
      <xs:element name="programa" type="TextoNoVacio"/>
      <xs:element name="centro" type="TextoNoVacio"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ========== Elemento raíz ========== -->
  <xs:element name="curriculum">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="nombre_completo" type="TextoNoVacio"/>
        <xs:element name="titulo" type="TextoNoVacio"/>
        <xs:element name="resumen" type="TextoNoVacio"/>
        <xs:element name="presentacion" type="PresentacionType"/>
        <xs:element name="sobre_mi" type="SobreMiType"/>
        <xs:element name="conocimientos" type="ConocimientosType"/>
        <xs:element name="actualmente_aprendiendo" type="ActualmenteAprendiendoType"/>
        <xs:element name="objetivo_de_practica" type="ObjetivoDePracticaType"/>
        <xs:element name="estudios" type="EstudiosType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
